# Обязательно: токен от @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# --- AI (по умолчанию Gemini: бесплатно, без карты, работает везде) ---

AI_PROVIDER=gemini
# Получить ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# --- Альтернатива: OpenCode Zen (OpenAI-совместимый API) ---
# ВНИМАНИЕ: бесплатный tier Zen отвечает только внутри самого OpenCode
# (ошибка FreeTierError). Для бота нужен ключ с внешним доступом.
# AI_PROVIDER=opencode_zen
# OPENCODE_ZEN_API_KEY=sk-your-opencode-zen-key
# OPENCODE_ZEN_MODEL=nemotron-3-ultra-free

# Максимальное ожидание ответа AI в секундах
# На телефоне можно 120, на сервере хватало 75
AI_RESPONSE_TIMEOUT=120

# Длина ответов и память (0 в CHAT_HISTORY_LIMIT/HOURS = без лимита, но жрёт RAM)
AI_MAX_TOKENS=4000
AI_HISTORY_MESSAGES=30
CHAT_HISTORY_LIMIT=5000
CHAT_HISTORY_HOURS=72

# Режим телефона (Termux): 1 — нет health-сервера, данные в ./data, логи в ./logs
PHONE_MODE=1

# Поиск в интернете (без AI и без ключей)
# AI_PROVIDER=web
